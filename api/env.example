# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Must match docker-compose.yml from Phase 1
PGHOST=localhost
PGPORT=5432
PGDATABASE=voltgrid
PGUSER=voltgrid_admin
PGPASSWORD=voltgrid_pass

# Generate a real random secret for this — do NOT use this placeholder in production.
# e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h
